#!/usr/bin/env python3
"""theme: switch every app in this setup to one color theme.

  theme              show the current theme
  theme list         list available themes
  theme <name>       switch to <name> (a unique prefix works: `theme tokyo`)
  theme reload       re-apply the current theme

Themes live in ~/.config/theme/themes/*.toml. Each one fills the same 26 color
slots (Catppuccin's slot names) plus, optionally, official theme names for apps
that have their own port. See ~/.config/theme/README.md.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import io
import time
import urllib.request
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config"
THEME_DIR = CONFIG / "theme"
THEMES = THEME_DIR / "themes"
GEN = THEME_DIR / "generated"
BACKUPS = THEME_DIR / "backups"
CURRENT = THEME_DIR / "current"

VSCODE_SETTINGS = HOME / "Library/Application Support/Code/User/settings.json"
ZED_SETTINGS = CONFIG / "zed/settings.json"
ZED_EXTENSIONS = HOME / "Library/Application Support/Zed/extensions/installed"
OBSIDIAN_VAULT = HOME / "Learn/Notes"
SPICETIFY = HOME / ".spicetify/spicetify"
SPICETIFY_CONFIG = CONFIG / "spicetify/config-xpui.ini"
SPICETIFY_THEME = CONFIG / "spicetify/Themes/palette"
CCSTATUSLINE = CONFIG / "ccstatusline/settings.json"
CCSTATUSLINE_MAP = THEME_DIR / "apps/ccstatusline.json"

SLOTS = [
    "base", "mantle", "crust", "surface0", "surface1", "surface2",
    "overlay0", "overlay1", "overlay2", "subtext0", "subtext1", "text",
    "rosewater", "flamingo", "pink", "mauve", "red", "maroon", "peach",
    "yellow", "green", "teal", "sky", "sapphire", "blue", "lavender",
]

HEADER = "Generated by `theme` from theme/themes/{id}.toml. Do not edit; run `theme <name>`."

# ─── Output ──────────────────────────────────────────────────────────────────

results = []


def ok(app, note=""):
    results.append(("\033[32m✓\033[0m", app, note))


def warn(app, note):
    results.append(("\033[33m⚠\033[0m", app, note))


def fail(app, note):
    results.append(("\033[31m✗\033[0m", app, note))


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "dotfiles-theme/1.0"})
    return urllib.request.urlopen(req, timeout=30).read()


def run(*cmd, check=True):
    return subprocess.run(cmd, capture_output=True, text=True, check=check)


def running(process):
    return run("pgrep", "-x", process, check=False).returncode == 0


def backup_once(path):
    """Copy a file that lives outside the repo before the first edit."""
    dest = BACKUPS / (path.name + "." + path.parent.name + ".orig")
    if path.exists() and not dest.exists():
        BACKUPS.mkdir(parents=True, exist_ok=True)
        stamp = time.strftime("%Y%m%d-%H%M%S")
        shutil.copy2(path, dest)
        shutil.copy2(path, BACKUPS / f"{path.name}.{path.parent.name}.{stamp}")


# ─── Theme files ─────────────────────────────────────────────────────────────


def parse_toml(path):
    """Tiny TOML subset: [section] headers and key = "string" pairs."""
    data = {}
    section = data
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = re.fullmatch(r"\[([\w-]+)\]", line)
        if m:
            section = data.setdefault(m.group(1), {})
            continue
        m = re.fullmatch(r'([\w-]+)\s*=\s*"([^"]*)"\s*(#.*)?', line)
        if not m:
            raise ValueError(f"{path.name}: can't parse line: {raw!r}")
        section[m.group(1)] = m.group(2)
    return data


def load_theme(theme_id):
    path = THEMES / f"{theme_id}.toml"
    data = parse_toml(path)
    colors = data.get("colors", {})
    missing = [s for s in SLOTS if s not in colors]
    if missing:
        sys.exit(f"{path.name} is missing colors: {', '.join(missing)}")
    for slot in SLOTS:
        if not re.fullmatch(r"#[0-9a-fA-F]{6}", colors[slot]):
            sys.exit(f"{path.name}: {slot} = {colors[slot]!r} is not a #rrggbb color")
        colors[slot] = colors[slot].lower()
    return {
        "id": theme_id,
        "name": data.get("name", theme_id),
        "official": data.get("official", {}),
        "c": colors,
    }


def theme_ids():
    return sorted(p.stem for p in THEMES.glob("*.toml"))


def resolve(name):
    ids = theme_ids()
    if name in ids:
        return name
    matches = [i for i in ids if name.lower() in i]
    if len(matches) == 1:
        return matches[0]
    sys.exit(f"Unknown theme '{name}'. Available: {', '.join(ids)}")


# ─── Generated files (read directly by apps) ─────────────────────────────────


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)


def gen_shell(t):
    lines = [f"# {HEADER.format(**t)}", f'THEME_ID="{t["id"]}"', f'THEME_NAME="{t["name"]}"']
    lines += [f'THEME_{s.upper()}="{t["c"][s]}"' for s in SLOTS]
    write(GEN / "colors.sh", "\n".join(lines) + "\n")


def gen_sketchybar(t):
    body = "\n".join(f"  {s} = 0xff{t['c'][s][1:]}," for s in SLOTS)
    write(GEN / "sketchybar.lua", f"-- {HEADER.format(**t)}\nreturn {{\n{body}\n}}\n")


def gen_tmux(t):
    c = t["c"]
    names = {"base": "bg", "text": "fg"}
    for s in SLOTS:
        if s in ("base", "text"):
            continue
        names[s] = re.sub(r"(\d)$", r"_\1", s)  # surface0 -> surface_0
    # catppuccin/tmux v2.1.3 ships subtext_0/subtext_1 swapped; match it so Mocha is identical.
    names["subtext0"], names["subtext1"] = "subtext_1", "subtext_0"
    lines = [f"# {HEADER.format(**t)}"]
    # The catppuccin/tmux plugin only fills @thm_* when unset, so ours win.
    lines += [f'set -g @thm_{names[s]} "{c[s]}"' for s in SLOTS]
    lines += [
        f'set -g pane-border-style "fg={c["surface1"]}"',
        f'set -g pane-active-border-style "fg={c["blue"]}"',
    ]
    write(GEN / "tmux.conf", "\n".join(lines) + "\n")


def gen_ghostty(t):
    c, official = t["c"], t["official"].get("ghostty")
    lines = [f"# {HEADER.format(**t)}"]
    if official:
        lines.append(f"theme = {official}")
    else:
        ansi = ["surface1", "red", "green", "yellow", "blue", "pink", "teal", "subtext1",
                "surface2", "red", "green", "yellow", "blue", "pink", "teal", "subtext0"]
        lines += [f"palette = {i}={c[s]}" for i, s in enumerate(ansi)]
        lines += [
            f"background = {c['base']}", f"foreground = {c['text']}",
            f"cursor-color = {c['rosewater']}", f"cursor-text = {c['base']}",
            f"selection-background = {c['surface2']}", f"selection-foreground = {c['text']}",
        ]
    write(GEN / "ghostty.conf", "\n".join(lines) + "\n")


def gen_spicetify(t):
    c = {s: v[1:] for s, v in t["c"].items()}
    roles = {
        "text": "text", "subtext": "subtext1", "main": "base", "main-elevated": "surface0",
        "highlight": "surface0", "highlight-elevated": "surface1", "sidebar": "mantle",
        "player": "crust", "card": "surface0", "shadow": "mantle", "selected-row": "overlay2",
        "button": "overlay1", "button-active": "overlay2", "button-disabled": "overlay0",
        "tab-active": "surface0", "notification": "surface0", "notification-error": "red",
        "misc": "surface1",
    }
    lines = [f"; {HEADER.format(**t)}", f"[{t['id']}]"]
    lines += [f"{k:<18} = {c[v]}" for k, v in roles.items()]
    lines.append(f"{'equalizer':<18} = 000000")
    lines += [f"{s:<18} = {c[s]}" for s in SLOTS]
    write(SPICETIFY_THEME / "color.ini", "\n".join(lines) + "\n")


# ─── Apps ────────────────────────────────────────────────────────────────────


def apply_sketchybar(t):
    if not shutil.which("sketchybar"):
        return warn("sketchybar", "not installed")
    run("sketchybar", "--reload", check=False)
    ok("sketchybar")


def apply_borders(t):
    rc = CONFIG / "borders/bordersrc"
    if not running("borders"):
        return warn("borders", "not running (starts with the new colors next time)")
    run("bash", str(rc), check=False)
    ok("borders")


def apply_tmux(t):
    if run("tmux", "info", check=False).returncode != 0:
        return ok("tmux", "no server running; picks it up on start")
    # The catppuccin plugin bakes colors into options it only sets when unset
    # (set -ogqF), so clear its options and let it rebuild them from scratch.
    # Options you set yourself come straight back from tmux.conf.
    cmds = []
    for flags in ("-g", "-gw"):
        for line in run("tmux", "show", flags, check=False).stdout.splitlines():
            name = line.split(" ", 1)[0]
            if name.startswith(("@catppuccin_", "@thm_")):
                cmds += ["set", flags + "u", name, ";"]
    if cmds:
        run("tmux", *cmds[:-1], check=False)
    run("tmux", "source-file", str(CONFIG / "tmux/tmux.conf"), check=False)
    ok("tmux")


def apply_ghostty(t):
    if running("ghostty"):
        run("pkill", "-USR2", "-x", "ghostty", check=False)  # Ghostty reloads config on SIGUSR2
    ok("ghostty", t["official"].get("ghostty", "palette"))


def apply_ccstatusline(t):
    if not CCSTATUSLINE.exists():
        return warn("ccstatusline", "settings.json not found")
    mapping = json.loads(CCSTATUSLINE_MAP.read_text())
    raw = CCSTATUSLINE.read_text()
    data = json.loads(raw)
    for line in data.get("lines", []):
        for item in line:
            slot = mapping.get(str(item.get("id")))
            if slot and "color" in item:
                item["color"] = t["c"][slot]
    out = json.dumps(data, indent=2, ensure_ascii=False) + ("\n" if raw.endswith("\n") else "")
    CCSTATUSLINE.write_text(out)
    ok("ccstatusline")


def apply_zed(t):
    name, ext = t["official"].get("zed"), t["official"].get("zed_extension")
    if not ZED_SETTINGS.exists():
        return warn("zed", "settings.json not found")
    if not name:
        name = "One Dark"
    if ext and not (ZED_EXTENSIONS / ext).exists():
        try:
            url = f"https://api.zed.dev/extensions/{ext}/download"
            blob = fetch(url)
            dest = ZED_EXTENSIONS / ext
            dest.mkdir(parents=True)
            with tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz") as tar:
                tar.extractall(dest, filter="data") if hasattr(tarfile, "data_filter") else tar.extractall(dest)
        except Exception as e:  # noqa: BLE001
            return fail("zed", f"couldn't install extension '{ext}': {e}")
    text = ZED_SETTINGS.read_text()
    new, n = re.subn(r'("theme"\s*:\s*\{[^}]*?"dark"\s*:\s*")[^"]*(")', rf"\g<1>{name}\g<2>", text, flags=re.S)
    if n == 0:
        return fail("zed", 'no "theme": { "dark": ... } block in settings.json')
    ZED_SETTINGS.write_text(new)
    ok("zed", name)


def apply_vscode(t):
    name, ext = t["official"].get("vscode"), t["official"].get("vscode_extension")
    if not VSCODE_SETTINGS.exists():
        return warn("vscode", "settings.json not found")
    if not name:
        name = "Default Dark Modern"
    if ext and shutil.which("code"):
        installed = run("code", "--list-extensions", check=False).stdout.lower().split()
        if ext.lower() not in installed:
            if run("code", "--install-extension", ext, check=False).returncode != 0:
                return fail("vscode", f"couldn't install {ext}")
    backup_once(VSCODE_SETTINGS)
    text = VSCODE_SETTINGS.read_text()
    new, n = re.subn(r'("workbench\.colorTheme"\s*:\s*")[^"]*(")', rf"\g<1>{name}\g<2>", text)
    if n == 0:
        return fail("vscode", '"workbench.colorTheme" not found in settings.json')
    VSCODE_SETTINGS.write_text(new)
    ok("vscode", name)


def apply_obsidian(t):
    name, repo = t["official"].get("obsidian", ""), t["official"].get("obsidian_repo")
    appearance = OBSIDIAN_VAULT / ".obsidian/appearance.json"
    if not appearance.exists():
        return warn("obsidian", f"vault not found at {OBSIDIAN_VAULT}")
    if name and repo:
        theme_dir = OBSIDIAN_VAULT / ".obsidian/themes" / name
        if not (theme_dir / "theme.css").exists():
            try:
                theme_dir.mkdir(parents=True, exist_ok=True)
                for f in ("manifest.json", "theme.css"):
                    url = f"https://raw.githubusercontent.com/{repo}/HEAD/{f}"
                    (theme_dir / f).write_bytes(fetch(url))
            except Exception as e:  # noqa: BLE001
                shutil.rmtree(theme_dir, ignore_errors=True)
                return fail("obsidian", f"couldn't download '{name}' from {repo}: {e}")
    backup_once(appearance)
    raw = appearance.read_text()
    data = json.loads(raw)
    data["cssTheme"] = name
    appearance.write_text(json.dumps(data, indent=2, ensure_ascii=False) + ("\n" if raw.endswith("\n") else ""))
    if running("Obsidian"):
        return warn("obsidian", f"{name or 'default'}; reload Obsidian (Cmd+R) to see it")
    ok("obsidian", name or "default")


def apply_spotify(t):
    if not SPICETIFY.exists():
        return warn("spotify", "spicetify not installed")
    text = SPICETIFY_CONFIG.read_text()
    text = re.sub(r"(?m)^(current_theme\s*=).*$", r"\1 palette", text)
    text = re.sub(r"(?m)^(color_scheme\s*=).*$", rf"\1 {t['id']}", text)
    SPICETIFY_CONFIG.write_text(text)
    app = Path("/Applications/Spotify.app/Contents/Resources/Apps")
    if (app / "xpui.spa").exists():
        return warn("spotify", "Spotify isn't patched yet; run the 'Update Spotify + Spicetify' script")
    was_running = running("Spotify")
    args = [str(SPICETIFY), "apply"] if was_running else [str(SPICETIFY), "-n", "apply"]
    r = run(*args, check=False)
    if r.returncode != 0 or "error" in r.stdout.lower():
        return fail("spotify", (r.stdout + r.stderr).strip().splitlines()[-1:] or "spicetify apply failed")
    ok("spotify", "restarted" if was_running else "applies next launch")


# ─── Main ────────────────────────────────────────────────────────────────────


def switch(theme_id):
    t = load_theme(theme_id)
    gen_shell(t)
    gen_sketchybar(t)
    gen_tmux(t)
    gen_ghostty(t)
    gen_spicetify(t)
    CURRENT.write_text(theme_id + "\n")

    for step in (apply_sketchybar, apply_borders, apply_tmux, apply_ghostty, apply_ccstatusline,
                 apply_zed, apply_vscode, apply_obsidian, apply_spotify):
        try:
            step(t)
        except Exception as e:  # noqa: BLE001
            fail(step.__name__.replace("apply_", ""), str(e))

    print(f"Theme: {t['name']}\n")
    for mark, app, note in results:
        print(f"  {mark} {app:<13} {note}")
    print("\n  New shells pick up the zsh colors; open ones keep the old ones until restarted.")
    return 0 if not any(r[0].endswith("✗\033[0m") for r in results) else 1


def current():
    return CURRENT.read_text().strip() if CURRENT.exists() else None


def main(argv):
    if not argv:
        cur = current()
        print(cur or "(no theme set)")
        return 0
    cmd = argv[0]
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if cmd == "list":
        cur = current()
        for i in theme_ids():
            name = load_theme(i)["name"]
            print(f"{'*' if i == cur else ' '} {i:<20} {name}")
        return 0
    if cmd == "reload":
        if not current():
            sys.exit("No current theme; run `theme <name>` first.")
        return switch(current())
    return switch(resolve(cmd))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
