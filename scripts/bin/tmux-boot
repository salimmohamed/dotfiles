#!/bin/bash
# tmux-boot - Bootstrap Claude Code sessions with interactive selection
#
# Usage:
#   tmux-boot           # Interactive multi-select
#   tmux-boot --all     # Boot all projects
#   tmux-boot --list    # List available projects
#   tmux-boot --add     # Add a new project
#   tmux-boot --remove  # Remove a project
#
# Dependencies: jq, gum, tmux, zoxide (optional)
#
set -euo pipefail

PROJECTS_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/claude-hooks/projects.json"

# Styling (Catppuccin Mocha theme)
export GUM_CHOOSE_CURSOR_FOREGROUND="#89b4fa"
export GUM_CHOOSE_SELECTED_FOREGROUND="#a6e3a1"
export GUM_CHOOSE_HEADER_FOREGROUND="#cba6f7"
export GUM_INPUT_CURSOR_FOREGROUND="#89b4fa"
export GUM_INPUT_PROMPT_FOREGROUND="#cba6f7"

# Check dependencies
check_deps() {
  local missing=()
  command -v jq &>/dev/null || missing+=("jq")
  command -v gum &>/dev/null || missing+=("gum")
  command -v tmux &>/dev/null || missing+=("tmux")

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Missing dependencies: ${missing[*]}"
    echo "Install with: brew install ${missing[*]}"
    exit 1
  fi

  if [[ ! -f "$PROJECTS_JSON" ]]; then
    echo "Projects config not found: $PROJECTS_JSON"
    echo "Create it at: $PROJECTS_JSON"
    echo 'Example: [{"name": "myproject", "path": "~/projects/myproject"}]'
    exit 1
  fi
}

# Get projects sorted by priority (use --frecency for zoxide ordering)
get_sorted_projects() {
  local sort_mode="${1:-priority}"

  if [[ "$sort_mode" == "frecency" ]] && command -v zoxide &>/dev/null; then
    while IFS= read -r path; do
      local expanded="${path/#\~/$HOME}"
      local score
      score=$(zoxide query --score "$expanded" 2>/dev/null | awk '{print $1}' || echo "0")
      local name
      name=$(jq -r ".[] | select(.path == \"$path\") | .name" "$PROJECTS_JSON")
      echo "$score $name"
    done < <(jq -r '.[].path' "$PROJECTS_JSON") | sort -rn | awk '{print $2}'
  else
    jq -r 'sort_by(.priority) | .[].name' "$PROJECTS_JSON"
  fi
}

# List projects
list_projects() {
  echo "Available projects:"
  jq -r '.[] | "  \(.name)\t\(.path)"' "$PROJECTS_JSON" | column -t -s $'\t'
}

# Add a new project
add_project() {
  local name path priority

  name=$(gum input --placeholder "project name" --prompt "Name: ")
  if [[ -z "$name" ]]; then
    echo "Cancelled"
    exit 0
  fi

  # Check for duplicate name
  if jq -e ".[] | select(.name == \"$name\")" "$PROJECTS_JSON" &>/dev/null; then
    echo "Project '$name' already exists"
    exit 1
  fi

  path=$(gum input --placeholder "~/dev/projects/myproject" --prompt "Path: ")
  if [[ -z "$path" ]]; then
    echo "Cancelled"
    exit 0
  fi

  # Expand and validate path
  local expanded="${path/#\~/$HOME}"
  if [[ ! -d "$expanded" ]]; then
    echo "Directory not found: $path"
    exit 1
  fi

  # Auto-assign next priority
  priority=$(jq '[.[].priority] | max + 1' "$PROJECTS_JSON")

  # Append to JSON
  jq --arg name "$name" --arg path "$path" --argjson pri "$priority" \
    '. += [{"name": $name, "path": $path, "priority": $pri}]' \
    "$PROJECTS_JSON" > "$PROJECTS_JSON.tmp" && mv "$PROJECTS_JSON.tmp" "$PROJECTS_JSON"

  echo "Added '$name' ($path)"
}

# Remove a project
remove_project() {
  local names
  names=$(jq -r '.[].name' "$PROJECTS_JSON")

  if [[ -z "$names" ]]; then
    echo "No projects to remove"
    exit 0
  fi

  local selected
  selected=$(echo "$names" | gum choose --header "Select project to remove:")

  if [[ -z "$selected" ]]; then
    echo "Cancelled"
    exit 0
  fi

  jq --arg name "$selected" 'map(select(.name != $name))' \
    "$PROJECTS_JSON" > "$PROJECTS_JSON.tmp" && mv "$PROJECTS_JSON.tmp" "$PROJECTS_JSON"

  echo "Removed '$selected'"
}

# Boot a single project
boot_project() {
  local name="$1"
  local project
  project=$(jq -r ".[] | select(.name == \"$name\")" "$PROJECTS_JSON")

  if [[ -z "$project" ]]; then
    echo "Project not found: $name"
    return 1
  fi

  local path
  path=$(echo "$project" | jq -r '.path' | sed "s|~|$HOME|")

  # Check if session already exists
  if tmux has-session -t "$name" 2>/dev/null; then
    echo "Session '$name' exists, switching..."
    if [[ -n "${TMUX:-}" ]]; then
      tmux switch-client -t "$name"
    else
      tmux attach -t "$name"
    fi
  else
    echo "Creating session '$name' in $path..."
    tmux new-session -d -s "$name" -c "$path"
    tmux send-keys -t "$name" "claude" Enter
    if [[ -n "${TMUX:-}" ]]; then
      tmux switch-client -t "$name"
    else
      tmux attach -t "$name"
    fi
  fi
}

# Main
main() {
  check_deps

  # Handle flags
  case "${1:-}" in
    --all)
      echo "Booting all projects..."
      while IFS= read -r name; do
        boot_project "$name" &>/dev/null &
        sleep 0.5
      done < <(get_sorted_projects)
      wait
      echo ""
      echo "Done! All sessions started with Claude."
      echo "Use Ctrl+a w for session chooser"
      ;;
    --list)
      list_projects
      ;;
    --add)
      add_project
      ;;
    --remove)
      remove_project
      ;;
    --help|-h)
      echo "Usage: tmux-boot [--all|--list|--add|--remove|--frecency|--help]"
      echo ""
      echo "  (no args)    Interactive multi-select (priority order)"
      echo "  --all        Boot all projects"
      echo "  --list       List available projects"
      echo "  --add        Add a new project"
      echo "  --remove     Remove a project"
      echo "  --frecency   Sort by zoxide frecency instead of priority"
      ;;
    *)
      # Interactive selection
      local sort_mode="priority"
      [[ "${1:-}" == "--frecency" ]] && sort_mode="frecency"
      local names
      names=$(get_sorted_projects "$sort_mode")

      if [[ -z "$names" ]]; then
        echo "No projects found in $PROJECTS_JSON"
        exit 1
      fi

      local selected
      selected=$(echo "$names" | gum choose --no-limit --header "Select projects (Tab=select, Enter=confirm):")

      if [[ -z "$selected" ]]; then
        echo "No projects selected"
        exit 0
      fi

      while IFS= read -r name; do
        boot_project "$name"
        sleep 0.5
      done <<< "$selected"

      echo ""
      echo "Done! Use Ctrl+a w for session chooser"
      ;;
  esac
}

main "$@"
