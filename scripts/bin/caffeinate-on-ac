#!/bin/bash
# Keep the Mac (and display) awake while on AC power; sleep normally on battery.
# Run by launchd: launchd/com.salim.caffeinate-on-ac.plist
pid=""

stop() {
  [[ -n $pid ]] && kill "$pid" 2>/dev/null
  pid=""
}

update() {
  if pmset -g ps | head -1 | grep -q "AC Power"; then
    if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
      caffeinate -di -w $$ &   # -w: exits with this script
      pid=$!
    fi
  else
    stop
  fi
}

trap 'stop; exit 0' TERM INT

update
# pslog prints a line on every power-source change
while read -r _; do update; done < <(pmset -g pslog)
