#!/bin/bash

# Colors come from the master theme (~/.config/theme). Switch with `theme <name>`.
source "$HOME/.config/theme/generated/colors.sh"

options=(
	style=round
	width=2.0
	hidpi=on
	active_color=0x99${THEME_BLUE#\#}   # theme blue at 60%: clear focus without being loud
	inactive_color=0x00000000  # Transparent (hides aerospace hidden window artifacts)
	order=above
	blacklist="Screen Studio"
)

borders "${options[@]}"
